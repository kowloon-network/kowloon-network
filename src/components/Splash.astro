---
// Hero scene: a day/night city skyline that follows the visitor's OS theme
// (falling back to local time if the browser reports no preference), with a
// drifting p5.js cloud layer and a flickering night-window effect.
//
// The two scenes are full illustrations exported as standalone SVGs (see
// src/assets/splash/) and inlined here via a raw import so window1–window8
// stay addressable by id for the flicker effect, without keeping thousands
// of lines of markup in this file.
import nightSceneSvg from '../assets/splash/night-scene.svg?raw';
import daySceneSvg from '../assets/splash/day-scene.svg?raw';
---

<div id="svgwrap">
  <div id="imgbg">
    <div id="clouds"></div>
    <div id="night" class="scene" set:html={nightSceneSvg} />
    <div id="day" class="scene" set:html={daySceneSvg} />
  </div>
  <div id="splash_title">Kowloon</div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>
<script is:inline>
  (function () {
    var SCENES = {
      night: { bg: '#130848', title: '#ffffff', cloud: [48, 25, 171] },
      day: { bg: '#ADD8E1', title: '#ffffff', cloud: [255, 255, 255] },
    };

    var imgbg = document.getElementById('imgbg');
    var titleEl = document.getElementById('splash_title');
    var darkMq = window.matchMedia('(prefers-color-scheme: dark)');
    var lightMq = window.matchMedia('(prefers-color-scheme: light)');

    var cloudColor = SCENES.night.cloud;
    var currentSceneId = 'night';

    function pickScene() {
      if (darkMq.matches) return 'night';
      if (lightMq.matches) return 'day';
      // Browser reports no OS preference — fall back to local time.
      var hour = new Date().getHours();
      return hour >= 6 && hour < 20 ? 'day' : 'night';
    }

    function applyScene() {
      var id = pickScene();
      var s = SCENES[id];
      document.querySelectorAll('.scene').forEach(function (el) {
        el.style.display = 'none';
      });
      document.getElementById(id).style.display = 'block';
      imgbg.style.background = s.bg;
      titleEl.style.color = s.title;
      cloudColor = s.cloud;
      currentSceneId = id;
    }

    applyScene();
    darkMq.addEventListener('change', applyScene);
    lightMq.addEventListener('change', applyScene);

    // Clouds — p5.js sketch, layered behind the scene SVGs. Reads
    // `cloudColor` on every frame, so it follows scene changes live.
    //
    // A plane rarely drifts across the same canvas, always at a fixed 45°
    // to the northwest (lower-right to upper-left), with a randomized start
    // Y/scale/speed each time. It's drawn after the clouds so it renders
    // above them, and — since this whole canvas sits below the building
    // SVGs in z-index — automatically behind the buildings too.
    //
    // Drop the real artwork at public/splash/plane.svg and this switches
    // from the placeholder triangle to it automatically, no code changes.
    new p5(function (p) {
      var clouds = [];
      var plane = null;
      var nextPlaneAt = 0;
      var planeImg = null;
      var planeReady = false;
      var planeBaseW = 130; // recomputed from canvas width in setup()

      var PLANE_ASPECT = 2334 / 2030; // native plane.svg viewBox
      // Fraction of canvas width the plane's base size is drawn at — this
      // must scale with the canvas, not be a fixed pixel value. At a fixed
      // 45° climb, the plane's own width is how much vertical "headroom" it
      // burns just entering the frame from off-screen right. On a narrow
      // (mobile) canvas that headroom cost was swallowing the whole flight
      // before it ever became visible, so the plane appeared to never show
      // up at all on phones.
      var PLANE_WIDTH_RATIO = 0.093;
      var PLANE_SPEED_MIN = 3.2;
      var PLANE_SPEED_MAX = 4.6;
      var PLANE_MIN_DELAY_MS = 25000;
      var PLANE_MAX_DELAY_MS = 70000;
      // Fixed 45° to the northwest — no rotation logic, ever. The artwork
      // is a perspective illustration already drawn in its one flight
      // attitude, not a silhouette meant to be rotated to face a heading.
      var PLANE_VX = -Math.SQRT1_2;
      var PLANE_VY = -Math.SQRT1_2;

      function scheduleNextPlane() {
        nextPlaneAt = p.millis() + p.random(PLANE_MIN_DELAY_MS, PLANE_MAX_DELAY_MS);
      }

      function launchPlane() {
        var scale = p.random(0.75, 1.25);
        var w = planeBaseW * scale;
        var h = w / PLANE_ASPECT;
        var speed = p.random(PLANE_SPEED_MIN, PLANE_SPEED_MAX);
        plane = {
          x: p.width + w,
          y: p.random(p.height * 0.45, p.height * 0.75),
          w: w,
          h: h,
          vx: PLANE_VX * speed,
          vy: PLANE_VY * speed,
        };
      }

      function drawPlane(pl) {
        if (planeReady && planeImg) {
          p.imageMode(p.CENTER);
          p.image(planeImg, pl.x + pl.w / 2, pl.y + pl.h / 2, pl.w, pl.h);
        } else {
          // Placeholder silhouette, already pointed northwest, until
          // public/splash/plane.svg loads.
          p.push();
          p.noStroke();
          p.fill(255, 255, 255, 235);
          p.beginShape();
          p.vertex(pl.x, pl.y + pl.h);
          p.vertex(pl.x + pl.w, pl.y + pl.h * 0.88);
          p.vertex(pl.x + pl.w * 0.7, pl.y + pl.h);
          p.vertex(pl.x + pl.w, pl.y + pl.h * 1.12);
          p.endShape(p.CLOSE);
          p.pop();
        }
      }

      p.preload = function () {
        planeImg = p.loadImage(
          '/splash/plane.svg',
          function () { planeReady = true; },
          function () { planeReady = false; }
        );
      };

      p.setup = function () {
        var container = document.getElementById('clouds');
        p.createCanvas(container.offsetWidth, container.offsetHeight).parent('clouds');
        p.noStroke();
        planeBaseW = p.width * PLANE_WIDTH_RATIO;
        // Sized as a fraction of canvas width, not a fixed pixel range —
        // on narrow (mobile) viewports a 400px cloud used to swallow the
        // whole sky. Max 20% of width keeps the same relative variety at
        // every screen size.
        var minSize = p.width * 0.03;
        var maxSize = p.width * 0.2;
        for (var i = 0; i < 20; i++) {
          clouds.push({
            x: p.random(p.width),
            y: p.random(p.height * 0.5),
            size: p.random(minSize, maxSize),
            speed: p.random(0.05, 0.2),
          });
        }
        scheduleNextPlane();
      };

      p.draw = function () {
        p.clear();
        p.fill(cloudColor[0], cloudColor[1], cloudColor[2]);
        for (var i = 0; i < clouds.length; i++) {
          var c = clouds[i];
          p.ellipse(c.x, c.y, c.size, c.size * 0.6);
          c.x += c.speed;
          if (c.x - c.size > p.width) c.x = -c.size;
        }

        // Day scene only — if the scene switches to night mid-flight (a
        // live OS-theme change), drop the plane immediately.
        if (currentSceneId !== 'day') {
          plane = null;
        } else if (!plane && p.millis() > nextPlaneAt) {
          launchPlane();
        }
        if (plane) {
          drawPlane(plane);
          plane.x += plane.vx;
          plane.y += plane.vy;
          if (plane.x < -plane.w || plane.y < -plane.h) {
            plane = null;
            scheduleNextPlane();
          }
        }
      };
    });

    // Window flicker — night scene only; harmless no-op when day is active
    // since window1–window8 don't exist in the day scene.
    var flickerColors = ['#dd308c', '#1b0360'];
    setInterval(function () {
      for (var i = 1; i <= 8; i++) {
        var el = document.getElementById('window' + i);
        if (el) el.style.fill = flickerColors[Math.floor(Math.random() * flickerColors.length)];
      }
    }, 3000);
  })();
</script>

<style>
  #svgwrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1024 / 576;
    overflow: hidden;
  }
  #svgwrap :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  #imgbg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  #clouds {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .scene {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    display: none;
  }
  #splash_title {
    text-transform: uppercase;
    position: absolute;
    bottom: 0;
    width: 100%;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 18vw, 20rem);
    line-height: 0.7;
    white-space: nowrap;
    z-index: 2;
    /* Without this, iOS Safari's automatic text-inflation heuristic can
       rescale this on events like tab refocus, shrinking it out of sync
       with the clamp()-computed size. */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }
</style>
