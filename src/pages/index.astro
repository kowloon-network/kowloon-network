---
import Base from '../layouts/Base.astro';
---

<Base title="Kowloon — coming soon">
  <main>
    <img src="/kowloon-mark.png" alt="Kowloon" class="mark" width="160" height="160" />
    <h1>KOWLOON</h1>
    <p class="tagline">Circles, not followers. No algorithm. Own your words.</p>
    <p class="soon">A new home for the open social web is on the way.</p>
    <p class="waitlist">Waitlist &amp; docs coming soon</p>
  </main>

  <style>
    main {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      gap: 0.5rem;
    }
    .mark {
      width: 160px;
      height: 160px;
      margin-bottom: 0.5rem;
    }
    h1 {
      font-weight: 700;
      letter-spacing: 0.28em;
      /* nudge right to visually center the tracked text */
      margin-left: 0.28em;
      font-size: clamp(1.75rem, 6vw, 3rem);
    }
    .tagline {
      font-family: 'Lora', Georgia, serif;
      font-size: clamp(1.1rem, 3.6vw, 1.6rem);
      line-height: 1.4;
      max-width: 30ch;
      opacity: 0.96;
      margin-top: 0.75rem;
    }
    .soon {
      opacity: 0.78;
      margin-top: 1.5rem;
      max-width: 34ch;
    }
    .waitlist {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      opacity: 0.55;
      margin-top: 0.75rem;
    }
  </style>
</Base>
