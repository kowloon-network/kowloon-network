---
import Base from '../layouts/Base.astro';
import Splash from '../components/Splash.astro';
---

<Base title="Kowloon — a social network built on circles, not followers">
  <header class="topbar">
    <span class="brand">KOWLOON</span>
    <a class="topbar-cta" href="#waitlist">Join the waitlist</a>
  </header>

  <!-- Full-bleed hero scene, right under the top bar. The "KOWLOON" title
       is rendered inside Splash itself, overlaid on the scene, so it
       replaces what used to be a separate <h1> below. -->
  <Splash />

  <main>
    <section class="hero">
      <p class="tagline">Circles, not followers.<br />No algorithm. Own your words.</p>

      <p class="lede">
        Kowloon is an open, federated social network built on one simple idea:
        you decide who you hear from. Gather people and communities into circles,
        read them newest-first with no algorithm in the way, and own every word
        you post &mdash; no ads, no follower counts, no crowd to perform for.
      </p>

      <a class="cta" href="#waitlist">Join the waitlist &rarr;</a>
      <p class="soon">A new home for the open social web is on the way.</p>
    </section>

    <section class="principles">
      <article>
        <span class="num">01</span>
        <h2>Circles, not followers</h2>
        <p>
          You share with people you choose, not an audience you perform for.
          Putting someone in a circle is the whole relationship &mdash; no
          follower counts, no clout, no numbers to chase.
        </p>
      </article>
      <article>
        <span class="num">02</span>
        <h2>No algorithm</h2>
        <p>
          Your feed is the people and communities you picked, newest first.
          Nothing is ranked, boosted, or reordered by a machine that profits
          from your attention.
        </p>
      </article>
      <article>
        <span class="num">03</span>
        <h2>Own your words</h2>
        <p>
          Kowloon is open source and yours to run. Self-host it, keep your data,
          and take everything with you. No lock-in, no landlord, no rug to pull.
        </p>
      </article>
    </section>

    <section class="download" id="download">
      <h2>Get the app</h2>
      <p>Kowloon is coming soon to iPhone and Android.</p>
      <div class="stores">
        <!-- When the apps ship, swap each span for <a href="STORE_URL"> and
             remove the is-soon class + aria-disabled. -->
        <span class="store-btn is-soon" role="link" aria-disabled="true">
          <small>Coming soon to the</small>
          <strong>App Store</strong>
        </span>
        <span class="store-btn is-soon" role="link" aria-disabled="true">
          <small>Coming soon to</small>
          <strong>Google Play</strong>
        </span>
      </div>
    </section>

    <section class="waitlist" id="waitlist">
      <h2>Kowloon opens soon.</h2>
      <p>Be first through the gate. We'll email you when it's time.</p>
      <!-- TODO: wire to Kit (ConvertKit) form -->
      <a class="cta" href="#">Join the waitlist &rarr;</a>
    </section>
  </main>

  <footer>
    <span>Kowloon &middot; open source &middot; {new Date().getFullYear()}</span>
  </footer>

  <style>
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem clamp(1.25rem, 5vw, 3rem);
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(6px);
      background: var(--topbar-bg);
    }
    .brand {
      font-weight: 700;
      letter-spacing: 0.24em;
      font-size: 0.95rem;
    }
    .topbar-cta {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      text-decoration: none;
      border: 1px solid var(--border);
      padding: 0.5rem 0.9rem;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .topbar-cta:hover {
      background: var(--accent-bg);
      color: var(--accent-fg);
    }

    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 clamp(1.25rem, 5vw, 3rem);
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(3rem, 8vw, 6rem);
    }
    .tagline {
      font-family: 'Lora', Georgia, serif;
      font-size: clamp(1.2rem, 4vw, 1.9rem);
      line-height: 1.35;
      margin-top: 1rem;
      opacity: 0.96;
    }
    .lede {
      max-width: 46ch;
      margin: 1.5rem auto 0;
      font-size: 1.05rem;
      line-height: 1.65;
      opacity: 0.82;
    }
    .soon {
      margin-top: 1.5rem;
      opacity: 0.72;
    }

    /* Shared CTA */
    .cta {
      display: inline-block;
      text-decoration: none;
      background: var(--accent-bg);
      color: var(--accent-fg);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.82rem;
      padding: 0.9rem 1.6rem;
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px var(--shadow);
    }

    /* Principles */
    .principles {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.5rem, 4vw, 3rem);
      padding: clamp(2rem, 6vw, 4rem) 0;
      border-top: 1px solid var(--border-soft);
    }
    .principles article .num {
      font-family: 'Lora', serif;
      font-size: 0.9rem;
      opacity: 0.5;
      letter-spacing: 0.1em;
    }
    .principles h2 {
      font-family: 'Lora', Georgia, serif;
      font-weight: 600;
      font-size: clamp(1.25rem, 2.6vw, 1.5rem);
      margin: 0.6rem 0 0.75rem;
    }
    .principles p {
      font-size: 0.98rem;
      line-height: 1.6;
      opacity: 0.85;
    }
    @media (max-width: 720px) {
      .principles {
        grid-template-columns: 1fr;
      }
    }

    /* Download */
    .download {
      text-align: center;
      padding: clamp(2.5rem, 7vw, 4.5rem) 0;
      border-top: 1px solid var(--border-soft);
    }
    .download h2 {
      font-family: 'Lora', Georgia, serif;
      font-weight: 600;
      font-size: clamp(1.5rem, 4.5vw, 2.2rem);
    }
    .download p {
      margin: 0.75rem 0 1.75rem;
      opacity: 0.82;
    }
    .stores {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .store-btn {
      display: inline-flex;
      flex-direction: column;
      align-items: flex-start;
      text-decoration: none;
      border: 1px solid var(--border);
      padding: 0.7rem 1.4rem;
      min-width: 180px;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .store-btn small {
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      opacity: 0.7;
    }
    .store-btn strong {
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .store-btn.is-soon {
      opacity: 0.5;
      cursor: default;
    }
    .store-btn:not(.is-soon):hover {
      background: var(--accent-bg);
      color: var(--accent-fg);
    }

    /* Waitlist */
    .waitlist {
      text-align: center;
      padding: clamp(3rem, 9vw, 6rem) 0;
      border-top: 1px solid var(--border-soft);
    }
    .waitlist h2 {
      font-family: 'Lora', Georgia, serif;
      font-weight: 600;
      font-size: clamp(1.6rem, 5vw, 2.4rem);
    }
    .waitlist p {
      margin: 0.75rem 0 1.75rem;
      opacity: 0.82;
    }

    footer {
      text-align: center;
      padding: 2.5rem 1.25rem;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.5;
      border-top: 1px solid var(--border-soft-2);
    }
  </style>
</Base>
