---
import Base from '../layouts/Base.astro';
import Splash from '../components/Splash.astro';
---

<Base title="Kowloon — a social network built on circles, not followers">
  <header class="topbar">
    <span class="brand">KOWLOON</span>
    <a class="topbar-cta" href="#waitlist">Join the waitlist</a>
  </header>

  <!-- Full-bleed hero scene, right under the top bar. The "KOWLOON" title
       is rendered inside Splash itself, overlaid on the scene, so it
       replaces what used to be a separate <h1> below. -->
  <Splash />

  <section class="screenshots" aria-label="Screenshots of the Kowloon app">
    <div class="screenshots-row">
      <button type="button" class="shot" data-full="/screenshots/feed-discover.webp" data-alt="Kowloon home feed showing the Discover row and a shared link post">
        <img src="/screenshots/feed-discover-thumb.webp" alt="Kowloon home feed showing the Discover row and a shared link post" loading="lazy" width="480" height="943" />
      </button>
      <button type="button" class="shot" data-full="/screenshots/discover-page.webp" data-alt="Kowloon Discover page with Media, Posts, and Circles rows">
        <img src="/screenshots/discover-page-thumb.webp" alt="Kowloon Discover page with Media, Posts, and Circles rows" loading="lazy" width="480" height="943" />
      </button>
      <button type="button" class="shot" data-full="/screenshots/composer-link.webp" data-alt="Composer for sharing a link post on Kowloon">
        <img src="/screenshots/composer-link-thumb.webp" alt="Composer for sharing a link post on Kowloon" loading="lazy" width="480" height="635" />
      </button>
      <button type="button" class="shot" data-full="/screenshots/composer-media.webp" data-alt="Composer for posting photos on Kowloon, with title and alt text fields">
        <img src="/screenshots/composer-media-thumb.webp" alt="Composer for posting photos on Kowloon, with title and alt text fields" loading="lazy" width="480" height="943" />
      </button>
      <button type="button" class="shot" data-full="/screenshots/audio-player.webp" data-alt="Kowloon post with an embedded audio album player">
        <img src="/screenshots/audio-player-thumb.webp" alt="Kowloon post with an embedded audio album player" loading="lazy" width="480" height="1040" />
      </button>
      <button type="button" class="shot" data-full="/screenshots/audio-player-dark.webp" data-alt="Kowloon audio player showing track list and playback controls">
        <img src="/screenshots/audio-player-dark-thumb.webp" alt="Kowloon audio player showing track list and playback controls" loading="lazy" width="480" height="943" />
      </button>
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous screenshot">&larr;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next screenshot">&rarr;</button>
  </div>

  <main>
    <section class="hero">
      <p class="tagline">
        A completely cool, multipurpose social network that's made for people, not profits.
      </p>

      <p class="lede">
        Kowloon is a free, open-source, federated social network unlike anything
        else that exists. It's focused on preserving privacy and replicating
        real-world human relationships rather than building social graphs for
        corporate and political interests to exploit and profit from. Kowloon
        combines old-school ideas from the golden age of the early Web with
        groovy new gestures that make it straight up cooler and more useful
        than anything else out there. And did we mention it's free?
      </p>

      <a class="cta hero-cta" href="#waitlist">Join the waitlist &rarr;</a>
    </section>

    <section class="content-section">
      <h2>Circles and Communities, Not Friends and Followers</h2>
      <p>
        Kowloon is a social network made up of smaller independent
        interconnected communities that are part of the global network but
        also function as their own &ldquo;walled cities,&rdquo; like the
        legendary Hong Kong enclave from which Kowloon takes its name. And
        instead of &ldquo;friends&rdquo; and &ldquo;followers,&rdquo; and an
        &ldquo;algorithm&rdquo; that decides what you see, Kowloon has <strong>Circles</strong>.
      </p>
      <p>
        Find a Kowloon community full of your friends or people with shared
        interests, and you can make any post public or community-only. Create
        a &ldquo;Friends&rdquo; Circle and a &ldquo;Family&rdquo; Circle and
        share pics of your kids to Family and dirty jokes to Friends. No one
        else can see these posts but the people you choose, and no one knows <em>which</em> Circle you've put them in&hellip; so nobody's feelings
        will get hurt if they're in your &ldquo;Friends&rdquo; Circle but not
        your &ldquo;BFFs&rdquo; Circle.
      </p>
      <p>
        Create a &ldquo;News&rdquo; Circle full of people and communities you
        trust to keep you up to date on current events and filter your
        timeline to only show Article posts from News Circle members while
        you're on the train headed to work; create a &ldquo;Fashionistas&rdquo;
        Circle and show Media posts to see the latest styles and trends.
        Choose Event posts from your &ldquo;Favorite Musicians&rdquo; Circle
        to figure out where you're gonna be next Saturday night.
      </p>
      <p>
        And you can share your Circles for other people to see and copy and
        find new and interesting people and communities to follow. In
        Kowloon, <em>you</em> are the algorithm.
      </p>
    </section>

    <section class="content-section">
      <h2>Freedom Of Speech, Freedom From Speech</h2>
      <p>
        Because Kowloon isn't a corporate-owned network but a federation of
        individual communities, no one but your community's admin can tell
        you what you can and can't say and post. No political or artistic
        censorship, no having to hide certain w**ds from an automated censor,
        no mysterious &ldquo;jail&rdquo; sentences or bans.
      </p>
      <p>
        But while we believe in freedom <em>of</em> speech, we also believe in
        freedom <em>from</em> speech. You can block not only individual users
        in Kowloon, but entire communities &mdash; you won't see anything from
        any member of that community. You have total control over not only
        who sees your post &mdash; the public, or only your community, or
        only people in one of your Circles &mdash; but who can reply or even
        react &mdash; so no creepy random people hearting all of your selfies
        in a row. You can even turn replies and reacts off entirely if you
        want to deliver a monologue rather than engage in a dialogue or open
        forum.
      </p>
    </section>

    <section class="content-section">
      <h2>The Social Swiss Army Knife</h2>
      <p>
        Kowloon allows you to create Groups in your community which can be
        open to the public or only fellow community members. You can also
        create Bookmarks that are links to anything available online, and
        share them with the world, your community, or keep them to yourself.
      </p>
      <p>
        And because all public posts in Kowloon appear on your community's
        public feed and on its Web frontend, and community admins can create
        WordPress-style static pages as well as posts, you can very easily
        use Kowloon as a publishing platform for one person or an entire
        organization. Kowloon is as useful for a single blogger wanting an
        easy-to-use platform as it is for a news publication or a nonprofit
        or real-world community to have a safe space so its members not only
        communicate with each other but publish to the world at large.
      </p>
    </section>

    <section class="content-section">
      <h2>Free As In Speech, Free As In Beer</h2>
      <p>
        Kowloon is entirely <a href="https://github.com/kowloon-network">open source</a> and built with the MERN stack (MongoDB, Express, React, Node.js), and
        it costs nothing &mdash; you can run the install script on your
        server and have a running Kowloon community server in five minutes!
      </p>
      <p>
        There are also mobile apps for iOS/Android that will be in the App
        Store and Play Store soon, which are also open source. Our future
        development roadmap also includes Mastodon/Fediverse integration and
        a plugin architecture to allow anyone to extend Kowloon.
      </p>
    </section>

    <section class="content-section">
      <h2>Current Status</h2>
      <p>
        Kowloon is currently in semi-private alpha &mdash; you can download
        and use the server software and the docs are on this site, but we're
        still testing the iOS and Android apps. But you can sign up for the
        waitlist to get notified when Kowloon goes into open beta!
      </p>
      <a class="cta" href="#waitlist">Join the waitlist &rarr;</a>
    </section>

    <section class="download" id="download">
      <h2>Get the app</h2>
      <p>Kowloon is coming soon to iPhone and Android.</p>
      <div class="stores">
        <!-- When the apps ship, swap each span for <a href="STORE_URL"> and
             remove the is-soon class + aria-disabled. -->
        <span class="store-btn is-soon" role="link" aria-disabled="true">
          <small>Coming soon to the</small>
          <strong>App Store</strong>
        </span>
        <span class="store-btn is-soon" role="link" aria-disabled="true">
          <small>Coming soon to</small>
          <strong>Google Play</strong>
        </span>
      </div>
    </section>

    <section class="waitlist" id="waitlist">
      <h2>Kowloon opens soon.</h2>
      <p>
        Sign up to be notified when Kowloon is open to the public. And don't
        worry &mdash; we won't sell your email address or add you to our
        mailing list. Once we've sent the email telling everyone it's ready,
        we'll delete the mailing list. Promise.
      </p>
      <form class="waitlist-form" id="waitlist-form">
        <input
          type="email"
          name="email"
          id="waitlist-email"
          class="waitlist-email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
        <button type="submit" class="cta">Join the waitlist &rarr;</button>
        <!-- Honeypot — invisible to real visitors, left blank by them.
             Bots that fill in every field trip it; caught silently
             server-side, not with display:none (some bots skip that). -->
        <span class="waitlist-hp" aria-hidden="true">
          <label for="waitlist-company">Company</label>
          <input type="text" id="waitlist-company" name="company" tabindex="-1" autocomplete="off" />
        </span>
      </form>
      <p class="waitlist-status" id="waitlist-status" role="status" aria-live="polite"></p>
    </section>
  </main>

  <footer>
    <span>Kowloon &middot; open source &middot; {new Date().getFullYear()}</span>
  </footer>

  <style>
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem clamp(1.25rem, 5vw, 3rem);
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(6px);
      background: var(--topbar-bg);
    }
    .brand {
      font-weight: 700;
      letter-spacing: 0.24em;
      font-size: 0.95rem;
    }
    .topbar-cta {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      text-decoration: none;
      border: 1px solid var(--border);
      padding: 0.5rem 0.9rem;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .topbar-cta:hover {
      background: var(--accent-bg);
      color: var(--accent-fg);
    }

    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 clamp(1.25rem, 5vw, 3rem);
    }

    /* Screenshots */
    .screenshots {
      padding: clamp(1.5rem, 4vw, 2.5rem) 0;
    }
    .screenshots-row {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      padding: 0 clamp(1.25rem, 5vw, 3rem) 0.5rem;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }
    .shot {
      flex: 0 0 auto;
      scroll-snap-align: start;
      display: block;
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      overflow: hidden;
      padding: 0;
      background: none;
      cursor: zoom-in;
      line-height: 0;
      transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .shot:hover,
    .shot:focus-visible {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px var(--shadow);
      border-color: var(--border);
    }
    .shot img {
      height: 280px;
      width: auto;
      display: block;
    }
    @media (max-width: 640px) {
      .shot img {
        height: 210px;
      }
    }

    /* Lightbox */
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.88);
      padding: clamp(1rem, 5vw, 3rem);
    }
    .lightbox[hidden] {
      display: none;
    }
    .lightbox-img {
      max-width: 100%;
      max-height: 100%;
      border-radius: 8px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }
    .lightbox-close,
    .lightbox-nav {
      position: fixed;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s ease;
    }
    .lightbox-close:hover,
    .lightbox-nav:hover {
      background: rgba(255, 255, 255, 0.18);
    }
    .lightbox-close {
      top: clamp(1rem, 4vw, 2rem);
      right: clamp(1rem, 4vw, 2rem);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      font-size: 1.5rem;
      line-height: 1;
    }
    .lightbox-nav {
      top: 50%;
      transform: translateY(-50%);
      width: 48px;
      height: 48px;
      border-radius: 50%;
      font-size: 1.25rem;
    }
    .lightbox-prev {
      left: clamp(0.75rem, 3vw, 2rem);
    }
    .lightbox-next {
      right: clamp(0.75rem, 3vw, 2rem);
    }
    @media (max-width: 640px) {
      .lightbox-nav {
        width: 40px;
        height: 40px;
      }
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(3rem, 8vw, 6rem);
    }
    .tagline {
      font-family: 'Lora', Georgia, serif;
      font-size: clamp(1.2rem, 4vw, 1.9rem);
      line-height: 1.35;
      margin-top: 1rem;
      opacity: 0.96;
    }
    .lede {
      max-width: 60ch;
      margin: 1.5rem auto 0;
      font-size: 1.05rem;
      line-height: 1.65;
      opacity: 0.82;
    }
    /* Shared CTA */
    .cta {
      display: inline-block;
      text-decoration: none;
      background: var(--accent-bg);
      color: var(--accent-fg);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.82rem;
      padding: 0.9rem 1.6rem;
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px var(--shadow);
    }

    /* Long-form content sections */
    .content-section {
      padding: clamp(2rem, 6vw, 4rem) 0;
      border-top: 1px solid var(--border-soft);
    }
    .content-section h2 {
      font-family: 'Lora', Georgia, serif;
      font-weight: 600;
      font-size: clamp(1.4rem, 3.6vw, 1.9rem);
      max-width: 68ch;
      margin-bottom: 1.25rem;
    }
    .content-section p {
      max-width: 68ch;
      font-size: 1rem;
      line-height: 1.7;
      opacity: 0.85;
      margin-bottom: 1.1rem;
    }
    .content-section p:last-of-type {
      margin-bottom: 1.5rem;
    }
    .content-section p a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }
    .content-section strong {
      font-weight: 600;
    }
    .content-section .cta {
      margin-top: 0.5rem;
    }
    .hero-cta {
      margin-top: 1.75rem;
    }

    /* Download */
    .download {
      text-align: center;
      padding: clamp(2.5rem, 7vw, 4.5rem) 0;
      border-top: 1px solid var(--border-soft);
    }
    .download h2 {
      font-family: 'Lora', Georgia, serif;
      font-weight: 600;
      font-size: clamp(1.5rem, 4.5vw, 2.2rem);
    }
    .download p {
      margin: 0.75rem 0 1.75rem;
      opacity: 0.82;
    }
    .stores {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .store-btn {
      display: inline-flex;
      flex-direction: column;
      align-items: flex-start;
      text-decoration: none;
      border: 1px solid var(--border);
      padding: 0.7rem 1.4rem;
      min-width: 180px;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .store-btn small {
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      opacity: 0.7;
    }
    .store-btn strong {
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .store-btn.is-soon {
      opacity: 0.5;
      cursor: default;
    }
    .store-btn:not(.is-soon):hover {
      background: var(--accent-bg);
      color: var(--accent-fg);
    }

    /* Waitlist */
    .waitlist {
      text-align: center;
      padding: clamp(3rem, 9vw, 6rem) 0;
      border-top: 1px solid var(--border-soft);
    }
    .waitlist h2 {
      font-family: 'Lora', Georgia, serif;
      font-weight: 600;
      font-size: clamp(1.6rem, 5vw, 2.4rem);
    }
    .waitlist p {
      max-width: 46ch;
      margin: 0.75rem auto 1.75rem;
      opacity: 0.82;
    }
    .waitlist-form {
      display: inline-flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .waitlist-email {
      font: inherit;
      font-size: 0.95rem;
      padding: 0.9rem 1.1rem;
      min-width: 260px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--fg);
    }
    .waitlist-email::placeholder {
      color: var(--fg);
      opacity: 0.45;
    }
    .waitlist-email:focus {
      outline: none;
      border-color: var(--klein);
    }
    .waitlist-form button.cta {
      border: none;
      font: inherit;
      cursor: pointer;
    }
    .waitlist-form button.cta:disabled {
      opacity: 0.6;
      cursor: default;
    }
    .waitlist-hp {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      left: -9999px;
    }
    .waitlist-status {
      margin-top: 1rem;
      font-size: 0.85rem;
      min-height: 1.2em;
    }
    .waitlist-status.is-error {
      color: #d64545;
    }

    footer {
      text-align: center;
      padding: 2.5rem 1.25rem;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.5;
      border-top: 1px solid var(--border-soft-2);
    }
  </style>

  <script>
    // Screenshot lightbox
    const shots = Array.from(document.querySelectorAll('.shot'));
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    let shotIndex = 0;

    function showShot(index) {
      shotIndex = (index + shots.length) % shots.length;
      const shot = shots[shotIndex];
      lightboxImg.src = shot.dataset.full;
      lightboxImg.alt = shot.dataset.alt || '';
    }
    function openLightbox(index) {
      showShot(index);
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      lightboxClose.focus();
    }
    function closeLightbox() {
      lightbox.hidden = true;
      lightboxImg.src = '';
      document.body.style.overflow = '';
    }

    shots.forEach((shot, i) => {
      shot.addEventListener('click', () => openLightbox(i));
    });
    lightboxClose.addEventListener('click', closeLightbox);
    lightboxPrev.addEventListener('click', () => showShot(shotIndex - 1));
    lightboxNext.addEventListener('click', () => showShot(shotIndex + 1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showShot(shotIndex - 1);
      if (e.key === 'ArrowRight') showShot(shotIndex + 1);
    });

    const form = document.getElementById('waitlist-form');
    const status = document.getElementById('waitlist-status');
    const emailInput = document.getElementById('waitlist-email');
    const companyInput = document.getElementById('waitlist-company');
    const button = form.querySelector('button[type="submit"]');
    // Roughly "page load" — used server-side as a minimum-fill-time bot
    // check, so it just needs to predate any realistic human submission.
    const loadedAt = Date.now();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.className = 'waitlist-status';

      const originalLabel = button.textContent;
      button.disabled = true;
      button.textContent = 'Joining…';

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: emailInput.value.trim(),
            company: companyInput.value,
            loadedAt,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.reset();
          alert("You're on the list. We'll email you when it's time.");
        } else {
          status.textContent = data.error || 'Something went wrong — try again.';
          status.classList.add('is-error');
        }
      } catch {
        status.textContent = 'Something went wrong — try again.';
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
        button.textContent = originalLabel;
      }
    });
  </script>
</Base>
