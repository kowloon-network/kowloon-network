---
// Base HTML shell + brand tokens. Every page wraps its content in this.
const {
  title = 'Kowloon',
  description = 'Kowloon — a different kind of social network. Circles, not followers. No algorithm. Own your words.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/kowloon-mark.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/kowloon-mark.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Lora:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --klein: #002fa7;
        --ink: #1a1a20;
        --paper: #ffffff;

        /* Theme tokens — dark by default, overridden below for light. The
           page chrome follows the same prefers-color-scheme signal the
           Splash scene reacts to in JS, so a dark OS gets the night scene
           + white-on-black chrome, and light gets the day scene + this
           block's black-on-white chrome. Declaring `color-scheme: light
           dark` (rather than just `dark`) tells browsers this page already
           handles both themes itself, so they shouldn't apply their own
           "force dark/light on websites" heuristics on top of it. */
        --bg: #000;
        --fg: var(--paper);
        --border: rgba(255, 255, 255, 0.4);
        --border-soft: rgba(255, 255, 255, 0.14);
        --border-soft-2: rgba(255, 255, 255, 0.1);
        --topbar-bg: rgba(0, 0, 0, 0.72);
        --shadow: rgba(0, 0, 0, 0.28);
        /* The bold solid CTA pill (.cta, and the hover fill on outline
           buttons) is a brand accent, not just "inverted page background" —
           reusing --fg for it would make it a heavy black pill in light
           mode. It swaps which of paper/klein is fill vs. text instead, so
           it's always a strong two-tone pop: white pill/blue text in dark,
           blue pill/white text in light. */
        --accent-bg: var(--paper);
        --accent-fg: var(--klein);
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: light) {
        :root {
          --bg: #ffffff;
          --fg: var(--ink);
          --border: rgba(0, 0, 0, 0.32);
          --border-soft: rgba(0, 0, 0, 0.12);
          --border-soft-2: rgba(0, 0, 0, 0.08);
          --topbar-bg: rgba(255, 255, 255, 0.78);
          --shadow: rgba(0, 0, 0, 0.16);
          --accent-bg: var(--klein);
          --accent-fg: var(--paper);
        }
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html,
      body {
        min-height: 100%;
      }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--fg);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
